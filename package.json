{
  "name": "claudedeck",
  "version": "0.1.0",
  "main": "main.js",
  "description": "ClaudeDeck - 複数の Claude Code セッションをグリッドで一括操作するターミナルアプリ",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "test": "npx playwright test",
    "test:unit": "npx playwright test --project=unit",
    "test:e2e": "npx playwright test --project=e2e",
    "test:headed": "npx playwright test --project=e2e --headed",
    "test:report": "npx playwright show-report",
    "rebuild": "electron-rebuild -f -w node-pty"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "electron": "^40.6.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
